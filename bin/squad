#!/bin/bash
# squad — tmux マルチエージェントシステム CLI
#
# start.sh / stop.sh のラッパー + セッション状態の確認。squad ディレクトリに
# cd しなくても任意の場所から操作できる。~/.local/bin 等への symlink を想定
# (readlink -f で実体を辿って SQUAD_ROOT を解決する)。
#
# 使い方:
#   squad start <workspace> [-s <session>]   # 起動 (session 既定: ros-agents)
#   squad stop [<session>]                   # 停止 (並行運用時は明示必須)
#   squad status                             # セッション / watcher 一覧
#   squad attach [<session>]                 # tmux attach
#   squad log [<session>] [-f]               # watcher ログ表示 (-f で follow)
#   squad root                               # SQUAD_ROOT を表示
set -u

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SQUAD_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
DEFAULT_SESSION="${SQUAD_SESSION:-ros-agents}"

usage() {
    sed -n '/^# 使い方:/,/^# *squad root/{s/^# \{0,3\}//p}' "$SELF"
}

# squad session 判定: watcher pidfile があるか、watcher プロセスの environ に
# SQUAD_SESSION が一致するものがあるか
watcher_pid_for() {
    local session="$1" pid
    if [ -f "/tmp/${session}-watch.pid" ]; then
        pid=$(cat "/tmp/${session}-watch.pid")
        kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
    fi
    for pid in $(pgrep -f "$SQUAD_ROOT/watch.sh" 2>/dev/null); do
        local env_session
        env_session=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
            | grep -m1 '^SQUAD_SESSION=' | cut -d= -f2)
        [ -z "$env_session" ] && env_session="ros-agents"
        [ "$env_session" = "$session" ] && { echo "$pid"; return 0; }
    done
    return 1
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    start)
        workspace=""
        session="$DEFAULT_SESSION"
        while [ $# -gt 0 ]; do
            case "$1" in
                -s|--session) session="$2"; shift 2 ;;
                -*) echo "不明なオプション: $1" >&2; exit 1 ;;
                *) workspace="$1"; shift ;;
            esac
        done
        if [ -z "$workspace" ]; then
            echo "使用方法: squad start <workspace> [-s <session>]" >&2
            exit 1
        fi
        exec env SQUAD_SESSION="$session" "$SQUAD_ROOT/start.sh" "$workspace"
        ;;
    stop)
        exec "$SQUAD_ROOT/stop.sh" "$@"
        ;;
    status)
        echo "SQUAD_ROOT: $SQUAD_ROOT"
        echo ""
        printf '%-20s %-10s %-12s %s\n' "SESSION" "TMUX" "WATCHER" "LOG"
        # 候補: tmux セッション + watcher pidfile の和集合
        {
            tmux list-sessions -F '#{session_name}' 2>/dev/null
            for f in /tmp/*-watch.pid; do
                [ -f "$f" ] || continue
                basename "$f" | sed 's/-watch\.pid$//'
            done
        } | sort -u | while read -r s; do
            [ -z "$s" ] && continue
            tmux_state="-"
            tmux has-session -t "$s" 2>/dev/null && tmux_state="alive"
            watcher_state="-"
            if pid=$(watcher_pid_for "$s"); then
                watcher_state="pid:$pid"
            fi
            # squad と無関係な tmux セッションは watcher も pidfile も無ければ省く
            [ "$watcher_state" = "-" ] && [ ! -f "/tmp/${s}-watch.log" ] && continue
            printf '%-20s %-10s %-12s %s\n' "$s" "$tmux_state" "$watcher_state" "/tmp/${s}-watch.log"
        done
        ;;
    attach)
        exec tmux attach -t "${1:-$DEFAULT_SESSION}"
        ;;
    log)
        session="$DEFAULT_SESSION"
        follow=0
        while [ $# -gt 0 ]; do
            case "$1" in
                -f|--follow) follow=1; shift ;;
                *) session="$1"; shift ;;
            esac
        done
        logfile="/tmp/${session}-watch.log"
        [ -f "$logfile" ] || { echo "ログがありません: $logfile" >&2; exit 1; }
        if [ "$follow" -eq 1 ]; then
            exec tail -f "$logfile"
        else
            exec tail -n 50 "$logfile"
        fi
        ;;
    root)
        echo "$SQUAD_ROOT"
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        echo "不明なコマンド: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
