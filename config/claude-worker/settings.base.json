{
  "permissions": {
    "allow": [],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/squad/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*.json)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.config/squad/*)",
      "Bash(cat *.pem*)",
      "Bash(cat *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(rm -f -r*)",
      "Bash(rm -Rf*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f)",
      "Bash(git push*-f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)"
    ],
    "ask": []
  },
  "model": "sonnet",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_CONFIG_DIR}/../../../../scripts/statusline.py\""
  }
}
